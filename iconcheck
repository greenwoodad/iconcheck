#!/bin/bash

# iconcheck
#
# Copyright 2021 University of Cincinnati
#
# This program is meant to be run as a cron job on a linux server to monitor ICON-NMR sessions
# on multiple NMR instruments. It copies IconDriverDebug and Inmracct files over from remote
# machines via SSH and checks them for new errors. If errors are found, it assembles them into
# log files and sends alert emails to the user or facility manager according to settings in the
# customizable file error_table. This requires that the local and remote computers have
# password-less SSH between them enabled via a private rsa key.

set -e
set -u

## Default parameter/flag settings -- change these if you wish

EmailFlag="y"             # Set to 'n' to refrain from sending emails when errors are detected
TrimFlag="y"              # Set to 'n' to let IconDriverDebug.Instrument.full grow uncontrollably
VerboseFlag="n"           # Set to 'y' to print informational messages
SendmailPath='/usr/sbin'  # Location of SendMail binary -- probably /usr/sbin, maybe /usr/bin?

#Check if sendmail is present
[[ -x "$SendmailPath/sendmail" ]] || { echo "sendmail not found at $SendmailPath/sendmail or not executable"; exit 1; }

## Functions

# Print message only when VerboseFlag is set
function log_verbose () {
    [[ "$VerboseFlag" == "y" ]] && echo "$@" || true
}

# Display usage information
function Show_Usage () {
    echo ""
    echo "Usage: iconcheck [OPTIONS]... path/to/iconcheck_input"
    echo ""
    echo "Options"
    echo " -h, -?, --help                            Show this help message."
    echo ""
    echo " -i, --input                               Set input file (flag optional)."
    echo ""
    echo " -e, --email (default y)                   Set to 'n' to skip sending emails"
    echo ""
    echo " -t, --trim (default y)                    Set to 'n' to skip trimming IconDriverDebug.Instrument.full"
    echo ""
    echo " -v, --verbose                             Print informational messages"
    echo ""
    echo "For more information, please see the README file:"
    echo "https://github.com/greenwoodad/iconcheck/README.md"
}

# Parse command-line flags
function parse_flags () {
    while [[ -n "${1-}" ]] ; do
        case "$1" in
            -h|-\?|--help)
                Show_Usage
                exit 0
                ;;
            -i|--input)
                shift
                Input="$1"
                ;;
            -e|--email)
                shift
                EmailFlag="$1"
                if ! [[ "$EmailFlag" == 'y' || "$EmailFlag" == 'n' ]]; then
                    echo "Invalid email option."
                    echo ""
                    Show_Usage
                    exit 1
                fi
                ;;
            -t|--trim)
                shift
                TrimFlag="$1"
                if ! [[ "$TrimFlag" == 'y' || "$TrimFlag" == 'n' ]]; then
                    echo "Invalid trim option."
                    echo ""
                    Show_Usage
                    exit 1
                fi
                ;;
            -v|--verbose)
                VerboseFlag="y"
                ;;
            -*)
                echo "Unknown option: \"$1\""
                Show_Usage
                exit 1
                ;;
            *)
                Input="$1"
                ;;
        esac
        shift
    done
}

# Send an email via sendmail
# Usage: Send_Email <to> <template> <subject_suffix>
# EmailText must be set before calling if the template references it
function Send_Email () {
    {
        echo "From: Do-Not-Reply@NMR-Facility"
        echo "To: $1"
        echo "Subject: NMR experiment on $Instrument $3"
        echo
        NMRUser="$NMRUser" Instrument="$Instrument" Spectrum="$Spectrum" \
            error="$error" EmailText="$EmailText" UserEmail="$UserEmail" \
            envsubst < "$ScriptsPath/emailtxt/$2"
    } | "$SendmailPath"/sendmail -t
    echo "Email sent to $1 | instrument: $Instrument | template: $2 | subject suffix: \"$3\""
}

# Trim IconDriverDebug.$Instrument.full when it gets too large
function TrimIconDriverDebug () {
    local Debuglog_length
    Debuglog_length="$(wc -l < "$DebugFileFull")"
    if [[ $Debuglog_length -gt 500000 ]]; then
        sed -i '1,250000d' "$DebugFileFull"
        log_verbose "IconDriverDebug.$Instrument.full reduced in length"
    fi
}

# Parse the input file for global settings and instrument list
function parse_input () {
    local Input_File="$1"

    ManagerEmail=$(grep -w "ManagerEmail" "$Input_File" | awk '{print $2}')
    ScriptsPath=$(grep -w "ScriptsPath" "$Input_File" | awk '{print $2}')

    [[ -z "$ManagerEmail" ]] && { echo "ManagerEmail is empty"; exit 1; }
    [[ -z "$ScriptsPath" ]] && { echo "ScriptsPath is empty"; exit 1; }
    [[ -z "$SendmailPath" ]] && { echo "SendmailPath is empty"; exit 1; }

    InputPath="$ScriptsPath/input"
    LogPath="$ScriptsPath/log"

    # Read list of instruments: everything after SSHAlias line, skipping comments and blank lines
    Instrument_Array=$(awk '/SSHAlias/{found=1; next} found && !/^#/ && NF {print $1}' "$Input_File")

}

# Copy Inmracct.brief and note any new spectrum failures
function read_Inmracct () {
    rsync -az -e "ssh -o ConnectTimeout=10" \
        "$RemoteUser"@"$Instrument":"$INMRPath"/Inmracct.brief \
        "$LogPath/Inmracct.brief.$Instrument"

    Failures=$(grep -A 1 -- 'Failure' "$LogPath/Inmracct.brief.$Instrument" | tail -n 10) || true

    SubjectAdd=""

    if test -f "$LogPath/recent_failures.$Instrument"; then
        local FailureFileContents
        FailureFileContents=$(cat "$LogPath/recent_failures.$Instrument")
        if [[ "$FailureFileContents" != "$Failures" ]]; then
            SubjectAdd=" **Sample Failure**"
            echo "$Failures" > "$LogPath/recent_failures.$Instrument"
        fi
    else
        # First run -- failures exist but are old, ignore them
        echo "$Failures" > "$LogPath/recent_failures.$Instrument"
        echo "New recent_failures.$Instrument file created, errors ignored"
    fi
}

# Copy the most recent IconDriverDebug file from the remote instrument
function copy_IconDriverDebug () {
    DebugFile="$LogPath/IconDriverDebug.$Instrument"

    local FindCmd
    FindCmd='cd '"$DebugPath"'; find IconDriverDebug* -type f -exec stat -c "%y %n" {} + | sort -r | cut -d " " -f4 | head -n 1'
    rsync -a --files-from=<(ssh -o ConnectTimeout=10 "$RemoteUser"@"$Instrument" "$FindCmd") \
        -e "ssh -o ConnectTimeout=10" \
        "$RemoteUser"@"$Instrument":"$DebugPath" \
        "$DebugFile"

    DebugFileFull="$LogPath/IconDriverDebug.$Instrument.full"
    touch "$DebugFileFull"

    if ! test -f "$LogPath/debugerrors.$Instrument.log"; then
        touch "$LogPath/debugerrors.$Instrument.log"
        Debug_New="y"
        echo "New debugerrors.$Instrument.log file created, errors ignored"
    else
        Debug_New="n"
    fi
}

# Append new content from the current IconDriverDebug file into the full log
function update_IconDriverDebugFull () {
    if grep -q "Auto_AcqIP .as.*.fm .*" "$DebugFileFull"; then
        local LastLine
        LastLine=$(grep "Auto_AcqIP .as.*.fm .*" "$DebugFileFull" | tail -n 1)
        # Escape backslashes, square brackets, and carets so they can be used in sed patterns
        LastLine=$(echo "$LastLine" | sed 's^\\^\x22\x27\\\\\x27\x22^g')
        LastLine=$(echo "$LastLine" | sed 's^\[^\x22\x27\\\[\x27\x22^g' \
                                    | sed 's^\]^\x22\x27\\\]\x27\x22^g' \
                                    | sed 's@\^@\x22\x27\\\^\x27\x22@g')

        # Truncate full log at LastLine then re-append from current debug file
        sed -i "/$(printf '%s' "$LastLine" | sed 's/[][\\/.*^$]/\\&/g')/Q" "$DebugFileFull"

        if grep -Fxq -- "$LastLine" "$DebugFile"; then
            # Current debug file contains LastLine -- append everything after it
            sed -n "\^$LastLine^,$ p" "$DebugFile" | tail -n +1 >> "$DebugFileFull"
        else
            # Debug file has rolled over -- append it in its entirety
            echo "$LastLine" >> "$DebugFileFull"
            cat "$DebugFile" >> "$DebugFileFull"
        fi
    else
        # No Auto_AcqIP lines yet -- replace full log with current debug file
        cat "$DebugFile" > "$DebugFileFull"
    fi
}

# Find new debug errors since the last run
function get_newdebugerrors () {
    local ErrorTableFile="$InputPath/error_table"
    if ! [[ -s "$ErrorTableFile" ]]; then
        echo "Error table not found at $ErrorTableFile! Exiting."
        exit 1
    fi

    # Build ErrorStringArray: skip header (first 2 lines), comments, blank lines.
    # Error string is everything except the last 3 fields (emailtemplate, mailuser, mailmanager).
    ErrorStringArray=$(awk 'NR>2 && !/^#/ && !/^$/ {
        str=""
        for (i=1; i<=NF-3; i++) str=str ($i" ")
        sub(/ $/, "", str)
        print str
    }' "$ErrorTableFile")

    # Find the 5 most recent instances of each error string in the full debug log
    RecentDebugErrors=''
    while IFS= read -r error_string; do
        RecentDebugErrors="$RecentDebugErrors"$'\n'$(grep -- "$error_string" "$LogPath/IconDriverDebug.$Instrument.full" | tail -n 5)
    done < <(echo "$ErrorStringArray")

    # Remove non-consecutive duplicate lines
    RecentDebugErrors=$(echo "$RecentDebugErrors" | perl -ne 'print if ! $x{$_}++')

    # Keep only errors that are new since last run
    NewDebugErrors=$(grep -vF -f "$LogPath/debugerrors.$Instrument.log" <<< "$RecentDebugErrors") || true

    # Remove blank lines
    NewDebugErrors=$(echo "$NewDebugErrors" | sed '/^$/d')
}

# Get the username and spectrum name corresponding to an error line
function get_user_spectrum () {
    local AddHistoryLine AfterCmd
    NMRUser=""
    Spectrum=""

    # Primary method: find the nearest preceding AddHistoryItem line going backward from the error.
    # Works across all instrument types and handles "NMR Data Already exist" correctly.
    AddHistoryLine=$(tac "$DebugFileFull" | grep -A 99999 -- "$error" \
        | grep -m1 -E "Auto_SetAddHistoryItem|AutoSet_AddHistoryItem") || true

    if [[ -n "$AddHistoryLine" ]]; then
        # Extract user: token immediately before /path {x} {x} {x}
        NMRUser=$(echo "$AddHistoryLine" \
            | grep -o '[^ ]* /[^ ]* {[^}]*} {[^}]*} {[^}]*}' \
            | awk '{print $1}') || true

        # Extract spectrum: strip command name and optional Tcl widget path token (e.g. .as.fm, .as_1.fm)
        AfterCmd=$(echo "$AddHistoryLine" \
            | grep -oE '(Auto_SetAddHistoryItem|AutoSet_AddHistoryItem) .*' \
            | sed 's/^[^ ]* //' | sed 's/^\.[^ ]*\.fm //') || true

        if [[ "$AfterCmd" == "{"* ]]; then
            Spectrum=$(echo "$AfterCmd" | grep -o '^{[^}]*}' | tr -d '{}')
        else
            Spectrum=$(echo "$AfterCmd" | awk '{print $1}')
        fi

        # Sanitize spectrum name
        Spectrum=$(echo "$Spectrum" \
            | sed 's^\&^and^g' | sed 's^\[^(^g' | sed 's^\]^)^g' | sed 's@\^@`@g')
    fi

    # Fallback: use Auto_AcqIP line if AddHistoryItem didn't resolve user or spectrum
    if [[ -z "${NMRUser-}" || -z "${Spectrum-}" ]]; then
        local UserSpectrumString UserSpectrumString_B UserSpectrumString_C UserSpectrumString_D
        local WithUnderbars_C WithUnderbars_D

        UserSpectrumString=$(tac "$DebugFileFull" | grep -A 99999 -- "$error" \
            | grep -m1 -o "Auto_AcqIP .as.*.fm .*") || true
        UserSpectrumString=$(echo "$UserSpectrumString" \
            | sed 's^\&^and^g' | sed 's^\[^(^g' | sed 's^\]^)^g' | sed 's@\^@`@g')

        UserSpectrumString_B=$(echo "$UserSpectrumString" | grep -o '{.*' | rev | grep -o '}.*' | rev)
        UserSpectrumString_C=$(echo "$UserSpectrumString_B" | rev | cut -d "{" -f1 | rev | cut -d "}" -f1)
        UserSpectrumString_D=$(echo "$UserSpectrumString_B" | sed 's^.$^^' | grep -o '.*}' | sed 's^.$^^' | cut -c 2-)
        WithUnderbars_C=$(echo "$UserSpectrumString_C" | sed 's^ ^_^g')
        WithUnderbars_D=$(echo "$UserSpectrumString_D" | sed 's^ ^_^g')

        Spectrum=$(echo "$UserSpectrumString" | sed "s^{$UserSpectrumString_C}^$WithUnderbars_C^g")
        Spectrum=$(echo "$Spectrum" \
            | sed "s^{$UserSpectrumString_D}^$WithUnderbars_D^g" | rev | cut -d' ' -f7 | rev)
        NMRUser=$(echo "$UserSpectrumString" | rev | cut -d' ' -f1 | rev | tr -d '{}')
		echo "Used fallback logic with $NMRUser and $Spectrum. AddHistoryLine was $AddHistoryLine"
    fi
}

## Main body

CurrentDay=$(date +'%m/%d/%Y')

parse_flags "$@"

if [[ "${Input-}" != "" && -f "${Input-}" ]]; then
    log_verbose "Input file is $Input."
else
    echo "No valid input file (\"${Input-}\" not provided or does not exist)."
    echo ""
    Show_Usage
    exit 1
fi

parse_input "$Input"
mkdir -p "$LogPath"

while IFS= read -r -u10 Instrument; do

    # Get per-instrument paths from input file
    RemoteUser=$(awk -v inst="$Instrument" '$1==inst {print $2}' "$Input")
    DebugPath=$(awk -v inst="$Instrument" '$1==inst {print $3}' "$Input")
    INMRPath=$(awk -v inst="$Instrument" '$1==inst {print $4}' "$Input")

    [[ -z "$INMRPath" ]] && { echo "INMRPath is empty for $Instrument"; exit 1; }

    if ! read_Inmracct; then
        echo "Warning: could not reach $Instrument for Inmracct, skipping"
        continue
    fi
    if ! copy_IconDriverDebug; then
        echo "Warning: could not reach $Instrument for IconDriverDebug, skipping"
        continue
    fi

    if ! [[ $(tail -n 1 "$DebugFileFull") == $(tail -n 1 "$DebugFile") ]]; then
        update_IconDriverDebugFull
    fi

    get_newdebugerrors

    # Initialize error so it's never unset even if NewDebugErrors is empty
    error=""

    if [[ $NewDebugErrors != "" ]]; then
        while IFS= read -r error; do
            # Initialize send flags and template for each error
            UserSend="n"
            ManagerSend="n"
            EmailTemplate=""
            EmailText=""
            # Match error against known error strings and look up email settings
            while IFS= read -r error_string; do
                if echo "$error" | grep -q -- "$error_string"; then
                    EmailTemplate=$(awk -v err="$error_string" \
                        '$0 ~ "^" err " " {print $(NF-2); exit}' "$InputPath/error_table")
                    UserSend=$(awk -v err="$error_string" \
                        '$0 ~ "^" err " " {print $(NF-1); exit}' "$InputPath/error_table")
                    ManagerSend=$(awk -v err="$error_string" \
                        '$0 ~ "^" err " " {print $NF; exit}' "$InputPath/error_table")
                    break
                fi
            done < <(echo "$ErrorStringArray")

            get_user_spectrum

            # Look up user email address
            UserEmail=""
            if [[ -s "$InputPath/addressbook" ]]; then
                UserEmail=$(grep -w "$NMRUser" "$InputPath/addressbook" | awk '{print $2}' | head -1) || true
                if [[ -z "$UserEmail" ]]; then
                    echo "No email address found for $NMRUser in $InputPath/addressbook"
                fi
            else
                echo "Address book file does not exist! Please make one in $InputPath/addressbook"
            fi

            # Pre-expand EmailText from the error-specific template so manager email can embed it
            [[ -n "$EmailTemplate" ]] && EmailText=$(cat "$ScriptsPath/emailtxt/$EmailTemplate") || true

            # Send emails according to error_table settings
            if [[ "$UserSend" == "y" && "$Debug_New" == "n" && "$EmailFlag" == "y" ]]; then
                Send_Email "$UserEmail" "$EmailTemplate" ""
                Send_Email "$ManagerEmail" "emailtxt_manager_a" "$SubjectAdd"
            elif [[ "$ManagerSend" == "y" && "$Debug_New" == "n" && "$UserSend" == "n" && "$EmailFlag" == "y" ]]; then
                Send_Email "$ManagerEmail" "emailtxt_manager_b" "$SubjectAdd"
            fi

            # Log the error
            echo "$CurrentDay spectrum: $Spectrum user: $NMRUser $SubjectAdd" >> "$LogPath/debugerrors.$Instrument.log"
            echo "$error" >> "$LogPath/debugerrors.$Instrument.log"

        done < <(echo "$NewDebugErrors")

    else
        # No debug errors -- send failure email if there was a sample failure
        if [[ $SubjectAdd != "" && "$EmailFlag" == "y" ]]; then
            NMRUser=""
            Spectrum=""
            UserEmail=""
            EmailText=""
            Send_Email "$ManagerEmail" "emailtxt_failure" "$SubjectAdd"
            echo "$CurrentDay $SubjectAdd" >> "$LogPath/debugerrors.$Instrument.log"
        fi
    fi

    if [[ "$TrimFlag" == 'y' ]]; then
        TrimIconDriverDebug
    fi

done 10< <(echo "${Instrument_Array}")

exit 0
